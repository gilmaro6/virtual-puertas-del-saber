# Configuración local del Servidor Backend
NODE_ENV=development
PORT=3000

# Base de datos MySQL
# Si ejecutas el backend fuera de Docker (ej. con Node en tu PC y MySQL en Docker o XAMPP), usa DB_HOST=localhost
DB_HOST=mysql
DB_PORT=3306
DB_NAME=puertas_del_saber_db
DB_USER=puertas_del_saber_user
DB_PASSWORD=puertas_del_saber_pass

# Seguridad y Autenticación JWT
JWT_SECRET=tu_clave_secreta_super_segura_aqui_cambiala_en_produccion
JWT_EXPIRES_IN=24h

# Origen permitido para CORS
CORS_ORIGIN=*
