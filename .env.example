# Configuración del Servidor Backend
NODE_ENV=development
PORT=3000

# Configuración de Base de Datos MySQL (para Docker y Backend)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=puertas_del_saber_db
DB_USER=puertas_del_saber_user
DB_PASSWORD=puertas_del_saber_pass
DB_ROOT_PASSWORD=root_master_pass

# Configuración de Autenticación JWT
JWT_SECRET=tu_clave_secreta_super_segura_aqui_cambiala_en_produccion
JWT_EXPIRES_IN=24h

# Configuración de CORS
CORS_ORIGIN=*
